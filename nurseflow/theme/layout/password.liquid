<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name | escape }}</title>
  <link rel="icon" type="image/svg+xml" href="{{ 'nf-favicon.svg' | asset_url }}">
  {% render 'nf-css-vars' %}
  {{ 'nf-theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="nf-template-password">
  <div class="nf-backdrop" aria-hidden="true"><span class="nf-blob nf-blob--a"></span><span class="nf-blob nf-blob--b"></span><span class="nf-blob nf-blob--c"></span></div>
  <main id="indhold">{{ content_for_layout }}</main>
</body>
</html>
