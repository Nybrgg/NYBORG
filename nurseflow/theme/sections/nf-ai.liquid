<section class="nf-section nf-container nf-ai" id="{{ section.settings.anchor | default: section.id | handleize }}" aria-labelledby="nf-title-{{ section.id }}">
  <div class="nf-ai__grid">
    <div class="nf-ai__copy">
      {% render 'nf-section-head', s: section.settings, id: section.id %}
      <ul class="nf-list-cards" data-nf-reveal>
        {%- for block in section.blocks -%}
          <li class="nf-glass" {{ block.shopify_attributes }}>
            <span class="nf-icon-tile nf-icon-tile--sm">{% render 'nf-icon', name: block.settings.icon, size: 18 %}</span>
            <div><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="nf-compare nf-glass" data-nf-compare data-nf-reveal>
      <div class="nf-segment" role="radiogroup" aria-label="{{ section.settings.switch_label | escape }}">
        <button type="button" role="radio" aria-checked="false" data-mode="a">{{ section.settings.label_a | escape }}</button>
        <button type="button" role="radio" aria-checked="false" data-mode="b">{{ section.settings.label_b | escape }}</button>
        <button type="button" role="radio" aria-checked="true" data-mode="both">{{ section.settings.label_both | escape }}</button>
        <span class="nf-segment__thumb" aria-hidden="true"></span>
      </div>
      <p class="nf-compare__q"><span class="nf-avatar" aria-hidden="true">{% render 'nf-icon', name: 'user', size: 14 %}</span>{{ section.settings.question | escape }}</p>
      <div class="nf-compare__answers" data-view="both">
        <article class="nf-answer" data-answer="a">
          <header><span class="nf-dot nf-dot--a" aria-hidden="true"></span>{{ section.settings.label_a | escape }}</header>
          <div>{{ section.settings.answer_a }}</div>
        </article>
        <article class="nf-answer" data-answer="b">
          <header><span class="nf-dot nf-dot--b" aria-hidden="true"></span>{{ section.settings.label_b | escape }}</header>
          <div>{{ section.settings.answer_b }}</div>
        </article>
      </div>
      {%- if section.settings.sources != blank -%}
        <div class="nf-sources">
          <span>{{ section.settings.sources_label | escape }}</span>
          {%- assign sources = section.settings.sources | split: ',' -%}
          {%- for src in sources -%}<span class="nf-chip">{{ src | strip | escape }}</span>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AI-assistent",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "ai-assistent" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Dual-AI" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "To AI'er. Ét svar du kan stole på." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Vælg Perplexity, OpenAI GPT-4o – eller sammenlign begge side om side. Svarene er på dansk, tilpasset dit semester og forankret i anerkendte retningslinjer.</p>" },
    { "type": "header", "content": "Sammenligning" },
    { "type": "text", "id": "switch_label", "label": "Skifter – skjult label", "default": "Vælg AI-udbyder" },
    { "type": "text", "id": "label_a", "label": "Udbyder A", "default": "Perplexity" },
    { "type": "text", "id": "label_b", "label": "Udbyder B", "default": "GPT-4o" },
    { "type": "text", "id": "label_both", "label": "Begge", "default": "Sammenlign begge" },
    { "type": "text", "id": "question", "label": "Eksempelspørgsmål", "default": "Hvordan bruger jeg SBAR, når jeg ringer til lægen?" },
    { "type": "richtext", "id": "answer_a", "label": "Svar A", "default": "<p><strong>S</strong> – Situation: hvem du er, patient og problem.<br><strong>B</strong> – Baggrund: diagnose, relevant forløb og medicin.<br><strong>A</strong> – Analyse: dine ABCDE-fund og vurdering.<br><strong>R</strong> – Råd: hvad du har brug for, og hvornår.</p>" },
    { "type": "richtext", "id": "answer_b", "label": "Svar B", "default": "<p>Start med <strong>Situationen</strong> i én sætning. Giv kort <strong>Baggrund</strong>, præsentér din <strong>Analyse</strong> med målte værdier (fx RF, SAT, BT, puls), og slut med en tydelig <strong>Rekommandation</strong>. Gentag aftalen til sidst – closed loop.</p>" },
    { "type": "text", "id": "sources_label", "label": "Kilder – label", "default": "Forankret i" },
    { "type": "text", "id": "sources", "label": "Kilder (kommasepareret)", "default": "Sundhedsstyrelsen, WHO, NICE, ICN" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Fordel",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ikon", "default": "sparkle", "options": [{"value": "chat", "label": "Chat"}, {"value": "calculator", "label": "Regner"}, {"value": "note", "label": "Note"}, {"value": "quiz", "label": "Quiz"}, {"value": "user", "label": "Profil"}, {"value": "sparkle", "label": "Gnister"}, {"value": "shield", "label": "Skjold"}, {"value": "book", "label": "Bog"}, {"value": "phone", "label": "Telefon"}, {"value": "globe", "label": "Globus"}, {"value": "compare", "label": "Sammenlign"}, {"value": "graduation", "label": "Studiehue"}, {"value": "heart", "label": "Hjerte"}, {"value": "stethoscope", "label": "Stetoskop"}, {"value": "chart", "label": "Graf"}, {"value": "clock", "label": "Ur"}, {"value": "syringe", "label": "Sprøjte"}, {"value": "vial", "label": "Ampul"}, {"value": "drip", "label": "Drop"}, {"value": "flask", "label": "Kolbe"}, {"value": "scale", "label": "Vægt"}, {"value": "pump", "label": "Pumpe"}, {"value": "convert", "label": "Konvertér"}, {"value": "atom", "label": "Elektrolyt"}] },
        { "type": "text", "id": "title", "label": "Titel", "default": "Automatisk fallback" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Hvis én AI er nede, skifter vi til den anden." }
      ]
    }
  ],
  "presets": [{ "name": "AI-assistent", "blocks": [{ "type": "point" }] }]
}
{% endschema %}
