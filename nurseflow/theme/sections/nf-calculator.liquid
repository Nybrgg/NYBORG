{%- liquid
  assign types = 'ampul|toerstof|vaeske|draaber|fortynding|vaegt|pumpe|enheder|elektrolyt' | split: '|'
  assign names = 'Ampulberegning|Tørstofberegning|Væske og infusion|Dråbehastighed|Koncentration og fortynding|Vægtbaseret dosering|Kontinuerlig infusion|Enhedskonvertering|Elektrolytberegning' | split: '|'
  assign icons = 'syringe|vial|drip|drop|flask|scale|pump|convert|atom' | split: '|'
-%}
<section class="nf-section nf-container nf-calculator" id="{{ section.settings.anchor | default: section.id | handleize }}" aria-labelledby="nf-title-{{ section.id }}">
  <div class="nf-calculator__grid">
    <div class="nf-calculator__aside">
      {% render 'nf-section-head', s: section.settings, id: section.id %}
      <ul class="nf-ticks" data-nf-reveal>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'nf-icon', name: 'check', size: 16 %}<span>{{ block.settings.text | escape }}</span></li>
        {%- endfor -%}
      </ul>
      <div class="nf-actions" data-nf-reveal>
        {% render 'nf-button', label: section.settings.cta_label, url: section.settings.cta_url, style: 'primary', icon: 'arrow' %}
      </div>
    </div>

    <div class="nf-calc nf-glass" data-nf-calc data-nf-reveal
      data-default="{{ section.settings.default_type }}"
      data-l-given="{{ 'nf.calc.given' | t }}" data-l-formula="{{ 'nf.calc.formula' | t }}" data-l-calc="{{ 'nf.calc.calculation' | t }}"
      data-l-result="{{ 'nf.calc.result' | t }}" data-l-check="{{ 'nf.calc.check' | t }}" data-l-invalid="{{ 'nf.calc.invalid' | t }}">
      <div class="nf-calc__tabs" role="tablist" aria-label="{{ 'nf.calc.categories' | t }}">
        {%- for t in types -%}
          <button type="button" role="tab" class="nf-calc__tab" id="nf-tab-{{ section.id }}-{{ t }}" aria-controls="nf-calc-panel-{{ section.id }}" aria-selected="false" tabindex="-1" data-type="{{ t }}">
            {% render 'nf-icon', name: icons[forloop.index0], size: 16 %}<span><small>{{ forloop.index }}</small>{{ names[forloop.index0] }}</span>
          </button>
        {%- endfor -%}
      </div>
      <div class="nf-calc__panel" id="nf-calc-panel-{{ section.id }}" role="tabpanel" tabindex="0">
        <form class="nf-calc__form" data-nf-calc-form novalidate>
          <div class="nf-calc__fields" data-nf-calc-fields></div>
          <button type="submit" class="nf-btn nf-btn--primary nf-calc__submit"><span>{{ 'nf.calc.calculate' | t }}</span>{% render 'nf-icon', name: 'calculator', size: 18 %}</button>
        </form>
        <div class="nf-calc__out" data-nf-calc-out aria-live="polite"></div>
        <noscript><p class="nf-muted">Medicinregneren kræver JavaScript.</p></noscript>
      </div>
      {%- if section.settings.disclaimer != blank -%}
        <p class="nf-calc__disclaimer">{% render 'nf-icon', name: 'alert', size: 16 %}<span>{{ section.settings.disclaimer | escape }}</span></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Medicinregner",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "medicinregner" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Medicinregner · 9 beregningstyper" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Regn sikkert. Trin for trin." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Skriv frit som “Beregn 75 mg fra 25 mg/ml ampul” i appen – eller prøv regneren her. Du får givne værdier, formel, beregning, resultat og en kontrol af, om tallet er realistisk.</p>" },
    {
      "type": "select", "id": "default_type", "label": "Starter på", "default": "ampul",
      "options": [
        { "value": "ampul", "label": "Ampulberegning" },
        { "value": "toerstof", "label": "Tørstofberegning" },
        { "value": "vaeske", "label": "Væske og infusion" },
        { "value": "draaber", "label": "Dråbehastighed" },
        { "value": "fortynding", "label": "Koncentration og fortynding" },
        { "value": "vaegt", "label": "Vægtbaseret dosering" },
        { "value": "pumpe", "label": "Kontinuerlig infusion" },
        { "value": "enheder", "label": "Enhedskonvertering" },
        { "value": "elektrolyt", "label": "Elektrolytberegning" }
      ]
    },
    { "type": "text", "id": "cta_label", "label": "Knaptekst", "default": "Åbn den fulde medicinregner" },
    { "type": "url", "id": "cta_url", "label": "Knaplink", "info": "Tom = link til webappen." },
    { "type": "textarea", "id": "disclaimer", "label": "Ansvarsfraskrivelse", "default": "Kun til undervisning og øvelse. Følg altid ordination, lokale instrukser og dobbeltkontrol – regneren erstatter ikke klinisk vurdering." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Punkt",
      "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Komma som decimaltegn" } ]
    }
  ],
  "presets": [{ "name": "Medicinregner", "blocks": [{ "type": "point" }] }]
}
{% endschema %}
