<section class="nf-section nf-container nf-contact">
  <div class="nf-prose nf-glass">
    {%- if section.settings.heading != blank -%}<h2 class="nf-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="nf-rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'contact', class: 'nf-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="nf-notice nf-notice--ok" role="status">{{ 'commerce.contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="nf-notice nf-notice--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label class="nf-field"><span>{{ 'commerce.contact.name' | t }}</span><input type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}"></label>
      <label class="nf-field"><span>{{ 'commerce.contact.email' | t }}</span><input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}"></label>
      <label class="nf-field"><span>{{ 'commerce.contact.message' | t }}</span><textarea name="contact[body]" rows="5">{{ form.body | escape }}</textarea></label>
      <button type="submit" class="nf-btn nf-btn--primary"><span>{{ 'commerce.contact.send' | t }}</span>{% render 'nf-icon', name: 'arrow', size: 18 %}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Kontaktformular",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Kontakt os" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Spørgsmål, idéer eller samarbejde med jeres uddannelsesinstitution? Skriv til os.</p>" }
  ],
  "presets": [{ "name": "Kontaktformular" }]
}
{% endschema %}
