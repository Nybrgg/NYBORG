<section class="nf-hero nf-container" id="{{ section.settings.anchor | default: 'top' | handleize }}" aria-labelledby="nf-hero-title-{{ section.id }}">
  <div class="nf-hero__copy" data-nf-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <p class="nf-pill nf-glass"><span class="nf-pill__dot" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 id="nf-hero-title-{{ section.id }}" class="nf-display">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_accent != blank %} <span class="nf-gradient-text">{{ section.settings.heading_accent | escape }}</span>{% endif -%}
    </h1>
    {%- if section.settings.text != blank -%}<div class="nf-lead">{{ section.settings.text }}</div>{%- endif -%}
    <div class="nf-actions">
      {% render 'nf-button', label: section.settings.primary_label, url: section.settings.primary_url, style: 'primary', icon: 'arrow' %}
      {%- if section.settings.secondary_label != blank -%}
        {% render 'nf-button', label: section.settings.secondary_label, url: section.settings.secondary_url, style: 'ghost' %}
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="nf-hero__stats">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.value | escape }}</strong><span>{{ block.settings.label | escape }}</span></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="nf-hero__visual" data-nf-reveal>
    {%- if section.settings.image -%}
      <div class="nf-hero__image nf-glass">
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 45vw, 92vw' }}
      </div>
    {%- else -%}
      <div class="nf-device" aria-hidden="true">
        <div class="nf-device__screen">
          <div class="nf-device__top"><span class="nf-logo-mark nf-logo-mark--sm">{% render 'nf-icon', name: 'plus', size: 12 %}</span><span>{{ settings.brand_name | default: 'NurseFlow' }} AI</span><span class="nf-device__chip">{{ section.settings.device_semester | escape }}</span></div>
          <div class="nf-chat">
            <p class="nf-chat__msg nf-chat__msg--me">{{ section.settings.device_question | escape }}</p>
            <div class="nf-chat__msg nf-chat__msg--ai nf-calc-card">
              <span class="nf-calc-card__row"><em>{{ 'nf.calc.given' | t }}</em>{{ section.settings.device_given | escape }}</span>
              <span class="nf-calc-card__row"><em>{{ 'nf.calc.formula' | t }}</em>{{ section.settings.device_formula | escape }}</span>
              <span class="nf-calc-card__row"><em>{{ 'nf.calc.calculation' | t }}</em>{{ section.settings.device_calc | escape }}</span>
              <span class="nf-calc-card__result">{{ section.settings.device_result | escape }}</span>
              <span class="nf-calc-card__check">{% render 'nf-icon', name: 'check', size: 14 %}{{ section.settings.device_check | escape }}</span>
            </div>
            <p class="nf-chat__typing"><span></span><span></span><span></span></p>
          </div>
          <div class="nf-device__input"><span>{{ section.settings.device_placeholder | escape }}</span><span class="nf-device__send">{% render 'nf-icon', name: 'arrow', size: 14 %}</span></div>
        </div>
      </div>
      <div class="nf-float nf-float--a nf-glass" aria-hidden="true">{% render 'nf-icon', name: 'shield', size: 18 %}<span>{{ section.settings.float_a | escape }}</span></div>
      <div class="nf-float nf-float--b nf-glass" aria-hidden="true">{% render 'nf-icon', name: 'compare', size: 18 %}<span>{{ section.settings.float_b | escape }}</span></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "top" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Gratis for sygeplejestuderende" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Din AI-studiemakker gennem" },
    { "type": "text", "id": "heading_accent", "label": "Overskrift – farvet del", "default": "hele sygeplejestudiet." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Stil spørgsmål på dansk, regn medicin trin for trin, og saml noter og quiz ét sted – tilpasset dit semester og danske retningslinjer.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primær knap", "default": "Kom i gang gratis" },
    { "type": "url", "id": "primary_url", "label": "Primær knap – link", "info": "Tom = link til webappen." },
    { "type": "text", "id": "secondary_label", "label": "Sekundær knap", "default": "Prøv medicinregneren" },
    { "type": "url", "id": "secondary_url", "label": "Sekundær knap – link", "default": "/" },
    { "type": "image_picker", "id": "image", "label": "Billede (valgfrit)", "info": "Erstatter den indbyggede app-illustration." },
    { "type": "header", "content": "App-illustration" },
    { "type": "text", "id": "device_semester", "label": "Semester-chip", "default": "4. semester" },
    { "type": "text", "id": "device_question", "label": "Spørgsmål", "default": "Beregn 75 mg fra 25 mg/ml ampul" },
    { "type": "text", "id": "device_given", "label": "Givet", "default": "Dosis 75 mg · styrke 25 mg/ml" },
    { "type": "text", "id": "device_formula", "label": "Formel", "default": "Volumen = dosis ÷ styrke" },
    { "type": "text", "id": "device_calc", "label": "Beregning", "default": "75 mg ÷ 25 mg/ml" },
    { "type": "text", "id": "device_result", "label": "Resultat", "default": "= 3 ml" },
    { "type": "text", "id": "device_check", "label": "Kontrol", "default": "Realistisk volumen til én ampul" },
    { "type": "text", "id": "device_placeholder", "label": "Inputfelt", "default": "Spørg om SBAR, ABCDE, farmakologi …" },
    { "type": "text", "id": "float_a", "label": "Svævende kort 1", "default": "Danske retningslinjer" },
    { "type": "text", "id": "float_b", "label": "Svævende kort 2", "default": "Sammenlign 2 AI-svar" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Nøgletal",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Tal", "default": "9" },
        { "type": "text", "id": "label", "label": "Tekst", "default": "beregningstyper" }
      ]
    }
  ],
  "presets": [{ "name": "Hero", "blocks": [{ "type": "stat" }] }]
}
{% endschema %}
