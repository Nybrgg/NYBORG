<section class="nf-section nf-container nf-page">
  <header class="nf-section-head"><h1 class="nf-title">{{ blog.title | escape }}</h1></header>
  {%- paginate blog.articles by 9 -%}
    {%- if blog.articles.size > 0 -%}
      <div class="nf-product-grid">
        {%- for article in blog.articles -%}
          <a class="nf-product-card nf-glass" href="{{ article.url }}">
            {%- if article.image -%}<span class="nf-product-card__media">{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 33vw, 92vw' }}</span>{%- endif -%}
            <span class="nf-product-card__body"><strong>{{ article.title | escape }}</strong><span>{{ article.published_at | date: '%d.%m.%Y' }}</span><span class="nf-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span></span>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="nf-pagination" aria-label="{{ 'nf.pagination' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- else -%}
      <p class="nf-muted">{{ 'commerce.blog.empty' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "Blog", "tag": "div", "settings": [] }
{% endschema %}
