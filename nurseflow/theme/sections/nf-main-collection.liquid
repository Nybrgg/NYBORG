<section class="nf-section nf-container nf-page">
  <header class="nf-section-head">
    <h1 class="nf-title">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="nf-intro">{{ collection.description }}</div>{%- endif -%}
  </header>
  {%- paginate collection.products by 12 -%}
    {%- if collection.products.size > 0 -%}
      <div class="nf-product-grid">
        {%- for product in collection.products -%}{% render 'nf-product-card', product: product %}{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="nf-pagination" aria-label="{{ 'nf.pagination' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- else -%}
      <p class="nf-muted">{{ 'commerce.collection.empty' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "Kollektion", "tag": "div", "settings": [] }
{% endschema %}
