<section class="nf-section nf-container nf-page">
  <header class="nf-section-head"><h1 class="nf-title">{{ 'commerce.collection.all' | t }}</h1></header>
  <div class="nf-product-grid">
    {%- for collection in collections -%}
      <a class="nf-product-card nf-glass" href="{{ collection.url }}">
        <span class="nf-product-card__media">
          {%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'nf-placeholder' }}{%- endif -%}
        </span>
        <span class="nf-product-card__body"><strong>{{ collection.title | escape }}</strong><span>{{ collection.products_count }}</span></span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Kollektioner", "tag": "div", "settings": [] }
{% endschema %}
