<section class="nf-section nf-container nf-page nf-page--center">
  <div class="nf-prose nf-glass nf-prose--center">
    <span class="nf-logo-mark nf-logo-mark--lg" aria-hidden="true">{% render 'nf-icon', name: 'plus', size: 28 %}</span>
    <h1 class="nf-title">{{ section.settings.heading | default: shop.name | escape }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message | escape }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'nf-form nf-search' -%}
      {%- if form.errors -%}<div class="nf-notice nf-notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="nf-visually-hidden" for="nf-password">{{ 'commerce.password.label' | t }}</label>
      <input id="nf-password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'commerce.password.label' | t }}">
      <button type="submit" class="nf-btn nf-btn--primary"><span>{{ 'commerce.password.submit' | t }}</span></button>
    {%- endform -%}
    <p class="nf-muted">{{ 'commerce.password.owner' | t }} <a href="/admin">{{ 'commerce.password.login' | t }}</a></p>
  </div>
</section>
{% schema %}
{
  "name": "Adgangskode",
  "tag": "div",
  "settings": [ { "type": "text", "id": "heading", "label": "Overskrift", "default": "NurseFlow åbner snart" } ]
}
{% endschema %}
