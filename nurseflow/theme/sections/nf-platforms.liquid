<section class="nf-section nf-container nf-platforms" id="{{ section.settings.anchor | default: section.id | handleize }}" aria-labelledby="nf-title-{{ section.id }}">
  <div class="nf-platforms__panel nf-glass nf-glass--strong">
    {% render 'nf-section-head', s: section.settings, id: section.id %}
    <div class="nf-platforms__grid">
      {%- for block in section.blocks -%}
        {%- assign href = block.settings.url -%}
        {%- if href == blank and block.settings.use_app_url -%}{%- assign href = settings.app_url -%}{%- endif -%}
        {%- if href != blank -%}<a class="nf-platform" href="{{ href | escape }}" data-nf-reveal {{ block.shopify_attributes }}>{%- else -%}<div class="nf-platform" data-nf-reveal {{ block.shopify_attributes }}>{%- endif -%}
          <span class="nf-icon-tile">{% render 'nf-icon', name: block.settings.icon, size: 24 %}</span>
          <span class="nf-platform__text"><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></span>
          {%- if block.settings.status != blank -%}<span class="nf-badge{% if block.settings.status_live %} nf-badge--live{% endif %}">{{ block.settings.status | escape }}</span>{%- endif -%}
        {%- if href != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="nf-platforms__note">{% render 'nf-icon', name: 'shield', size: 16 %}<span>{{ section.settings.note | escape }}</span></p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Web og app",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "app" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Web, iOS og Android" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Ét login. Samme historik. Overalt." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Webappen og mobilappen deler samme backend, så dine samtaler, noter og beregninger følger med – på computeren i læsesalen og på telefonen i praktikken.</p>" },
    { "type": "text", "id": "note", "label": "Note", "default": "API-nøgler ligger aldrig i appen – al AI-trafik går gennem vores egen server." }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ikon", "default": "globe", "options": [ { "value": "globe", "label": "Web" }, { "value": "apple", "label": "iOS" }, { "value": "android", "label": "Android" }, { "value": "phone", "label": "Telefon" } ] },
        { "type": "text", "id": "title", "label": "Titel", "default": "Webapp" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Virker i alle browsere" },
        { "type": "text", "id": "status", "label": "Status", "default": "Klar nu" },
        { "type": "checkbox", "id": "status_live", "label": "Status er 'live' (grøn)", "default": true },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "use_app_url", "label": "Brug webapp-linket, hvis Link er tomt", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Web og app", "blocks": [{ "type": "platform" }] }]
}
{% endschema %}
