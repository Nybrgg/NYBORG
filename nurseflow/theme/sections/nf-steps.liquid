<section class="nf-section nf-container nf-steps" id="{{ section.settings.anchor | default: section.id | handleize }}" aria-labelledby="nf-title-{{ section.id }}">
  {% render 'nf-section-head', s: section.settings, id: section.id, align: 'center' %}
  <ol class="nf-steps__list">
    {%- for block in section.blocks -%}
      <li class="nf-glass" data-nf-reveal style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <span class="nf-steps__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <span class="nf-icon-tile">{% render 'nf-icon', name: block.settings.icon, size: 22 %}</span>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </li>
    {%- endfor -%}
  </ol>
</section>

{% schema %}
{
  "name": "Sådan virker det",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "saadan-virker-det" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Kom i gang på to minutter" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Sådan virker det" },
    { "type": "richtext", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Trin",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ikon", "default": "user", "options": [{"value": "chat", "label": "Chat"}, {"value": "calculator", "label": "Regner"}, {"value": "note", "label": "Note"}, {"value": "quiz", "label": "Quiz"}, {"value": "user", "label": "Profil"}, {"value": "sparkle", "label": "Gnister"}, {"value": "shield", "label": "Skjold"}, {"value": "book", "label": "Bog"}, {"value": "phone", "label": "Telefon"}, {"value": "globe", "label": "Globus"}, {"value": "compare", "label": "Sammenlign"}, {"value": "graduation", "label": "Studiehue"}, {"value": "heart", "label": "Hjerte"}, {"value": "stethoscope", "label": "Stetoskop"}, {"value": "chart", "label": "Graf"}, {"value": "clock", "label": "Ur"}, {"value": "syringe", "label": "Sprøjte"}, {"value": "vial", "label": "Ampul"}, {"value": "drip", "label": "Drop"}, {"value": "flask", "label": "Kolbe"}, {"value": "scale", "label": "Vægt"}, {"value": "pump", "label": "Pumpe"}, {"value": "convert", "label": "Konvertér"}, {"value": "atom", "label": "Elektrolyt"}] },
        { "type": "text", "id": "title", "label": "Titel", "default": "Opret din profil" },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "Vælg universitet, campus og semester." }
      ]
    }
  ],
  "presets": [{ "name": "Sådan virker det", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
