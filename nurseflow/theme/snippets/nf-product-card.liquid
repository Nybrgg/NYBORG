<a class="nf-product-card nf-glass" href="{{ product.url }}">
  <span class="nf-product-card__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'nf-placeholder' }}
    {%- endif -%}
  </span>
  <span class="nf-product-card__body">
    <strong>{{ product.title | escape }}</strong>
    <span>{% if product.available %}{{ product.price | money }}{% else %}{{ 'commerce.product.sold_out' | t }}{% endif %}</span>
  </span>
</a>
