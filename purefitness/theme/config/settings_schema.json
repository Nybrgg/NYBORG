[
  {
    "name": "theme_info",
    "theme_name": "PureFitness Universe",
    "theme_author": "PureFitness",
    "theme_version": "2.0.0",
    "theme_documentation_url": "https://help.shopify.com/da/manual/online-store/themes",
    "theme_support_url": "https://purefitness.dk"
  },
  {
    "name": "Identitet",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Navn i navigationen",
        "default": "PUREFITNESS"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (valgfrit)"
      },
      {
        "type": "url",
        "id": "universe_url_override",
        "label": "Universlink (tom = indbygget 3D-univers)"
      }
    ]
  },
  {
    "name": "Farver",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accentfarve",
        "default": "#d4ed72"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Tekstfarve",
        "default": "#191e1c"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Sidebaggrund",
        "default": "#fafbf7"
      }
    ]
  },
  {
    "name": "Scroll-effekter",
    "settings": [
      {
        "type": "checkbox",
        "id": "stack_sections",
        "label": "Stak forsidens sektioner ved scroll",
        "info": "Sektionerne under heroen bliver liggende, og den næste glider ind over den forrige.",
        "default": true
      },
      {
        "type": "range",
        "id": "stack_offset",
        "label": "Synlig kant af tidligere sektioner",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "smooth_scroll",
        "label": "Blød scroll på forsiden",
        "info": "Gælder mus og touchpad. Telefoner og tablets bruger deres egen scroll.",
        "default": true
      },
      {
        "type": "range",
        "id": "scroll_speed",
        "label": "Scrollhastighed",
        "min": 40,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 65
      },
      {
        "type": "range",
        "id": "scroll_smoothness",
        "label": "Blødhed",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 6
      }
    ]
  },
  {
    "name": "Forsidens søgemaskinetekst",
    "settings": [
      {
        "type": "text",
        "id": "home_title",
        "label": "Sidetitel",
        "default": "Purefitness | Stærke rum. Større muligheder."
      },
      {
        "type": "textarea",
        "id": "home_description",
        "label": "Beskrivelse",
        "default": "Purefitness skaber komplette træningsmiljøer for fitnesscentre, hoteller, virksomheder og foreninger. Udstyr, indretning, installation og service."
      },
      {
        "type": "text",
        "id": "universe_title",
        "label": "Sidetitel: 3D-universet",
        "default": "Purefitness | Oplev universet"
      },
      {
        "type": "text",
        "id": "contact_title",
        "label": "Sidetitel: kontaktsiden",
        "default": "Kontakt Purefitness"
      }
    ]
  },
  {
    "name": "Fælles tilgængelighed",
    "settings": [
      {
        "type": "text",
        "id": "skip_label",
        "label": "Spring til indhold-knap",
        "default": "Gå til indhold"
      }
    ]
  }
]