<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_ink }}">
  <title>{% if template.suffix == 'univers' %}{% if settings.universe_title != blank %}{{ settings.universe_title | escape }}{% else %}{{ 'pf.universe_title' | t }}{% endif %}{% elsif template.suffix == 'contact' %}{% if settings.contact_title != blank %}{{ settings.contact_title | escape }}{% else %}{{ 'pf.contact_title' | t }}{% endif %}{% elsif template.name == 'index' %}{{ settings.home_title | escape }}{% else %}{{ page_title | escape }}{% unless page_title contains shop.name %} | {{ shop.name | escape }}{% endunless %}{% endif %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% elsif template.name == 'index' %}<meta name="description" content="{{ settings.home_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  {{ 'manrope-400.woff' | asset_url | preload_tag: as: 'font', type: 'font/woff' }}
  {{ 'manrope-500.woff' | asset_url | preload_tag: as: 'font', type: 'font/woff' }}
  <script>document.documentElement.classList.add('pf-js');</script>
  {{ 'pf-design.css' | asset_url | stylesheet_tag }}
  {% style %}
    @font-face{font-family:Manrope;font-style:normal;font-weight:400;font-display:swap;src:url({{ 'manrope-400.woff' | asset_url }}) format('woff')}
    @font-face{font-family:Manrope;font-style:normal;font-weight:500;font-display:swap;src:url({{ 'manrope-500.woff' | asset_url }}) format('woff')}
    @font-face{font-family:Manrope;font-style:normal;font-weight:800;font-display:swap;src:url({{ 'manrope-800.woff' | asset_url }}) format('woff')}
    :root{--pf-accent:{{ settings.color_accent }};--pf-ink:{{ settings.color_ink }};--pf-paper:{{ settings.color_paper }};--pf-ambient-image:url({{ 'pf-ambient.webp' | asset_url }});--accent:{{ settings.color_accent }}}
  {% endstyle %}
  {{ content_for_header }}
  <script src="{{ 'pf-theme.js' | asset_url }}" defer></script>
  <script src="{{ 'pf-glass-flow.js' | asset_url }}" defer></script>
  {% if template.name == 'index' %}<script type="module" src="{{ 'pf-universe-entry.js' | asset_url }}"></script>{% endif %}
</head>
<body{% if template.suffix == 'univers' %} class="pf-universe-page"{% endif %}>
  {% if template.suffix == 'univers' %}
    {{ content_for_layout }}
  {% else %}
    <div class="landing{% unless template.name == 'index' and template.suffix == blank %} pf-inner-page{% endunless %}{% if template.name == 'index' and template.suffix == blank and settings.stack_sections %} pf-stack-enabled{% endif %}" data-pf-home-shell{% if template.name == 'index' and template.suffix == blank and settings.smooth_scroll %} data-pf-smooth-scroll="{{ settings.scroll_speed | default: 65 }},{{ settings.scroll_smoothness | default: 6 }}"{% endif %} style="--pf-stack-offset:{{ settings.stack_offset | default: 10 }}px">
      <a class="skip-link" href="#indhold">{{ settings.skip_label | escape }}</a>
      {% sections 'header-group' %}
      <div class="pf-glass-ambient" data-pf-glass-ambient aria-hidden="true"></div>
      <main id="indhold">{{ content_for_layout }}</main>
      {% sections 'footer-group' %}
    </div>
  {% endif %}
  {% section 'pf-contact-project' %}
  {% section 'pf-contact-service' %}
  {% section 'pf-contact-catalogue' %}
</body>
</html>
