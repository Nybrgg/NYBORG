{% liquid
  assign universe_url = routes.root_url | append: '?view=univers'
  if settings.universe_url_override != blank
    assign universe_url = settings.universe_url_override
  endif
%}
{% if section.settings.show_section %}
<section id="kontakt-{{ section.id }}" class="pf-section pf-closing pf-simple-section pf-container" data-pf-anchor="kontakt" {% if section.settings.show_heading and section.settings.heading != blank %}aria-labelledby="contact-title-{{ section.id }}"{% endif %} {% render 'pf-section-glass', s: section.settings %}>
  {% if section.settings.glass_enabled and section.settings.glass_flow_enabled %}<span class="pf-section-glass-wave" aria-hidden="true"></span>{% endif %}
  {% if section.settings.show_image != false %}
    <div class="pf-closing__media" aria-hidden="true">
      {% render 'pf-image', image: section.settings.image, asset: 'next-universe.webp', alt: '', loading: 'lazy', sizes: '100vw', width: 1440, height: 900 %}
    </div>
  {% endif %}
  <div class="pf-closing__card pf-glass" data-pf-reveal>
    {% if section.settings.show_heading and section.settings.heading != blank %}<h2 id="contact-title-{{ section.id }}" class="pf-title">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.show_description and section.settings.description != blank %}<p class="pf-lead">{{ section.settings.description | escape | newline_to_br | replace: '<br />', ' ' | replace: '<br>', ' ' }}</p>{% endif %}
    {% if section.settings.show_buttons and section.blocks.size > 0 %}<div class="pf-actions">{% for block in section.blocks %}{% render 'pf-action-button', block: block, universe_url: universe_url %}{% endfor %}</div>{% endif %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Purefitness · Kontakt",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Vis sektionen",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Fortæl os om jeres projekt."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Introduktion",
      "default": "Har I et nyt træningsrum i tankerne, eller vil I udvikle det, I allerede har?\nFortæl os om jeres behov, så kan vi tage den første samtale."
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Vis overskriften",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Vis beskrivelsen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Vis knapper",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Vis baggrundsbillede",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Baggrundsbillede",
      "info": "Tomt felt bruger en visualisering fra 3D-universet."
    },
    {
      "type": "header",
      "content": "Farver og afstande"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Baggrund",
      "default": "#202722"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Overskrifter og tekst",
      "default": "#edf0e8"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Brødtekst",
      "default": "#b2bbae"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent og knapper",
      "default": "#d4ed72"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Afstand over indhold",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Afstand under indhold",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Afstand over indhold på mobil",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Afstand under indhold på mobil",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Glas og bevægelse"
    },
    {
      "type": "checkbox",
      "id": "glass_enabled",
      "label": "Glasbaggrund",
      "default": true
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Baggrundsopacitet",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 86
    },
    {
      "type": "range",
      "id": "glass_blur",
      "label": "Sløring",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "checkbox",
      "id": "glass_flow_enabled",
      "label": "Bløde lysbølger ved scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "glass_flow_strength",
      "label": "Lysbølgernes styrke",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purefitness · Kontakt",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Kontakt PureFitness",
            "destination": "projekt",
            "style": "primary",
            "icon": "move-up-right",
            "icon_size": 18
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Knap eller link",
      "settings": [
        {
          "type": "checkbox",
          "id": "visible",
          "label": "Vis knappen",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "Knaptekst",
          "default": "Kontakt PureFitness"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Egen destination (har førsteprioritet)"
        },
        {
          "type": "select",
          "id": "destination",
          "label": "Handling uden egen destination",
          "options": [
            {
              "value": "universe",
              "label": "3D-universet"
            },
            {
              "value": "solutions",
              "label": "Løsninger på forsiden"
            },
            {
              "value": "contact",
              "label": "Kontakt på forsiden"
            },
            {
              "value": "projekt",
              "label": "Projektformular"
            },
            {
              "value": "katalog",
              "label": "Katalogformular"
            },
            {
              "value": "service",
              "label": "Serviceformular"
            }
          ],
          "default": "projekt"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Udseende",
          "options": [
            {
              "value": "primary",
              "label": "Fyldt knap"
            },
            {
              "value": "secondary",
              "label": "Understreget link"
            },
            {
              "value": "line",
              "label": "Enkelt tekstlink"
            }
          ],
          "default": "primary"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "options": [
            {
              "value": "move-up-right",
              "label": "Skrå pil"
            },
            {
              "value": "arrow-up-right",
              "label": "Pil op til højre"
            },
            {
              "value": "arrow-down",
              "label": "Pil ned"
            },
            {
              "value": "arrow-right",
              "label": "Pil mod højre"
            },
            {
              "value": "none",
              "label": "Intet ikon"
            }
          ],
          "default": "move-up-right"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Egen knapbaggrund (valgfrit)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Egen knaptekstfarve (valgfrit)"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Ikonstørrelse",
          "min": 12,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 18
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
