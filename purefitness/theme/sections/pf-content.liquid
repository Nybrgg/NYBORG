<section id="pf-content-{{ section.id }}" class="pf-content-section page-width" style="--pf-content-bg:{{ section.settings.background }};--pf-content-ink:{{ section.settings.text_color }};--pf-content-accent:{{ section.settings.accent_color }};--pf-content-top:{{ section.settings.padding_top }}px;--pf-content-bottom:{{ section.settings.padding_bottom }}px;--pf-content-align:{{ section.settings.text_alignment }};max-width:{{ section.settings.max_width }}px">
  {% if section.settings.heading != blank %}<h2 class="pf-content-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
  {% if section.settings.intro != blank %}<div class="pf-content-richtext">{{ section.settings.intro }}</div>{% endif %}
  {% for block in section.blocks %}{% if block.settings.visible %}
    <div class="pf-content-block pf-content-block-{{ block.type }}" style="--pf-block-color:{{ block.settings.text_color }};--pf-block-font:{{ block.settings.font_size }}px;--pf-block-gap:{{ block.settings.spacing }}px;--pf-block-align:{{ block.settings.text_alignment }}" {{ block.shopify_attributes }}>
      {% case block.type %}
        {% when 'heading' %}<h3>{{ block.settings.heading | escape }}</h3>
        {% when 'text' %}<div class="pf-content-richtext">{{ block.settings.content }}</div>
        {% when 'image' %}{% if block.settings.image != blank %}<figure>{{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '480, 800, 1200, 1600, 2400', sizes: '(max-width: 760px) 100vw, 80vw', alt: block.settings.image_alt }}{% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}</figure>{% endif %}
        {% when 'button' %}
          {% if block.settings.action != 'link' or block.settings.url != blank %}{% if block.settings.action == 'link' %}<a class="pf-content-button" href="{{ block.settings.url | escape }}" style="--pf-button-bg:{{ block.settings.background }};--pf-button-ink:{{ block.settings.text_color }}" {% if block.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ block.settings.label | escape }}{% if block.settings.show_arrow %}{% render 'pf-icon', name: 'arrow-up-right', size: 18 %}{% endif %}</a>{% else %}<button type="button" class="pf-content-button" data-pf-contact="{{ block.settings.action | escape }}" style="--pf-button-bg:{{ block.settings.background }};--pf-button-ink:{{ block.settings.text_color }}">{{ block.settings.label | escape }}{% if block.settings.show_arrow %}{% render 'pf-icon', name: 'arrow-up-right', size: 18 %}{% endif %}</button>{% endif %}{% endif %}
      {% endcase %}
    </div>
  {% endif %}{% endfor %}
</section>
{% stylesheet %}
  .pf-content-section{background:var(--pf-content-bg);color:var(--pf-content-ink);padding-top:var(--pf-content-top);padding-bottom:var(--pf-content-bottom);text-align:var(--pf-content-align)}
  .pf-content-section .pf-content-heading{color:var(--pf-content-ink);font-size:clamp(2rem,4vw,3.5rem);line-height:1.15;margin:0 0 25px}
  .pf-content-section .pf-content-richtext{color:inherit;line-height:1.75;overflow-wrap:anywhere}
  .pf-content-section .pf-content-richtext p{color:inherit;font-size:inherit;margin:0 0 20px}.pf-content-section .pf-content-block .pf-content-richtext p{color:inherit;font-size:inherit}
  .pf-content-section .pf-content-richtext a{color:var(--pf-content-accent);text-decoration:underline;text-underline-offset:4px}
  .pf-content-section .pf-content-block{color:var(--pf-block-color);font-size:var(--pf-block-font);margin-top:var(--pf-block-gap);text-align:var(--pf-block-align)}
  .pf-content-section .pf-content-block h3{color:inherit;font-size:inherit;line-height:1.2;margin:0}
  .pf-content-section figure{margin:0}.pf-content-section figure img{width:100%;height:auto}.pf-content-section figcaption{color:inherit;font-size:inherit;margin-top:12px}
  .pf-content-section .pf-content-button{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-height:48px;padding:13px 20px;background:var(--pf-button-bg);color:var(--pf-button-ink);border:0;font:inherit;text-decoration:none;cursor:pointer}
  .pf-content-section .pf-content-button:focus-visible{outline:2px solid var(--pf-content-accent);outline-offset:4px}
{% endstylesheet %}
