{% if section.settings.show_section != false %}
<section id="intro-{{ section.id }}" data-pf-anchor="intro" class="pf-section pf-intro pf-simple-section pf-container"{% if section.settings.show_heading != false and section.settings.heading != blank %} aria-labelledby="intro-title-{{ section.id }}"{% endif %} {% render 'pf-section-glass', s: section.settings %}>
  {% if section.settings.glass_enabled and section.settings.glass_flow_enabled %}<span class="pf-section-glass-wave" aria-hidden="true"></span>{% endif %}
  <div class="pf-intro__copy" data-pf-reveal>
    {% if section.settings.show_heading != false and section.settings.heading != blank %}<h2 id="intro-title-{{ section.id }}" class="pf-title">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.show_description_1 != false and section.settings.description_1 != blank %}<p class="pf-lead">{{ section.settings.description_1 | escape | newline_to_br }}</p>{% endif %}
    {% if section.settings.show_description_2 != false and section.settings.description_2 != blank %}<p class="pf-body">{{ section.settings.description_2 | escape | newline_to_br }}</p>{% endif %}
    {% capture intro_actions %}
      {% for block in section.blocks %}
        {% if block.type == 'button' and block.settings.visible != false and block.settings.label != blank %}
          {% liquid
            assign action_class = 'pf-button pf-button--primary'
            if block.settings.style == 'link'
              assign action_class = 'pf-link'
            elsif block.settings.style == 'glass'
              assign action_class = 'pf-button pf-button--glass'
            endif
          %}
          {% capture action_style %}{% if block.settings.background_color != blank %}--pf-button-bg:{{ block.settings.background_color }};{% endif %}{% if block.settings.text_color != blank %}--pf-button-text:{{ block.settings.text_color }};color:{{ block.settings.text_color }};{% endif %}{% endcapture %}
          {% if block.settings.url != blank %}
            <a class="{{ action_class }}" href="{{ block.settings.url | escape }}" style="{{ action_style }}" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><span class="pf-button__icon">{% render 'pf-icon', name: 'move-up-right', size: 18 %}</span></a>
          {% elsif block.settings.action_kind != 'link' %}
            <button type="button" class="{{ action_class }}" data-pf-contact="{{ block.settings.action_kind | escape }}" style="{{ action_style }}" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><span class="pf-button__icon">{% render 'pf-icon', name: 'move-up-right', size: 18 %}</span></button>
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endcapture %}
    {% assign intro_actions = intro_actions | strip %}
    {% if intro_actions != blank %}<div class="pf-actions">{{ intro_actions }}</div>{% endif %}
    {% assign pillar_blocks = section.blocks | where: 'type', 'pillar' %}
    {% if pillar_blocks.size > 0 %}
      <ul class="pf-intro__pillars">
        {% for block in pillar_blocks %}{% if block.settings.label != blank %}<li{% if block.settings.accent != blank %} style="--pf-pillar-accent:{{ block.settings.accent }}"{% endif %} {{ block.shopify_attributes }}><span class="pf-intro__pillar-title">{{ block.settings.label | escape }}</span>{% if block.settings.text != blank %}<span class="pf-intro__pillar-text">{{ block.settings.text | escape }}</span>{% endif %}</li>{% endif %}{% endfor %}
      </ul>
    {% elsif section.settings.show_eyebrow != false and section.settings.eyebrow != blank %}
      {% assign pillars = section.settings.eyebrow | split: '·' %}
      <ul class="pf-intro__pillars" aria-label="{{ section.settings.eyebrow | escape }}">
        {% for pillar in pillars %}<li><span class="pf-intro__pillar-title">{{ pillar | strip | escape }}</span></li>{% endfor %}
      </ul>
    {% endif %}
  </div>
  {% if section.settings.show_image != false %}
    <figure class="pf-intro__media pf-frame" data-pf-reveal style="--pf-image-blend:{{ section.settings.image_blend }}%;">
      {% if section.settings.image_url != blank %}<a href="{{ section.settings.image_url | escape }}">{% endif %}
      {% render 'pf-image', image: section.settings.image, mobile_image: section.settings.mobile_image, asset: 'premium-interior.webp', alt: section.settings.image_alt, loading: 'lazy', sizes: '(max-width:760px) 100vw, 55vw', width: 1672, height: 941 %}
      {% if section.settings.image_url != blank %}</a>{% endif %}
    </figure>
  {% endif %}
</section>
{% endif %}

{% schema %}
{
  "name": "Purefitness · Partner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Vis sektionen",
      "default": true
    },
    {
      "type": "header",
      "content": "Indhold"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Vis overlinje",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Vis overskrift",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description_1",
      "label": "Vis første afsnit",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description_2",
      "label": "Vis andet afsnit",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overlinje",
      "default": "Udstyr · Indretning · Service",
      "info": "Bruges som søjler, hvis der ikke er tilføjet blokke af typen Søjle. Adskil med ·."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Én partner til hele træningsmiljøet."
    },
    {
      "type": "textarea",
      "id": "description_1",
      "label": "Første afsnit",
      "default": "Et godt træningsrum starter med at forstå dem, der skal bruge det. Hvem er rummet til, hvad skal det kunne, og hvordan skal det fungere i hverdagen?"
    },
    {
      "type": "textarea",
      "id": "description_2",
      "label": "Andet afsnit",
      "default": "PureFitness hjælper med at samle udstyr, indretning og service i en løsning, der passer til jeres rammer og ambitioner. Her kan I udforske mulighederne og tage den første samtale om jeres projekt."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Træningsmiljø"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Billedbeskrivelse",
      "default": "Illustrativt premium træningsmiljø med sort styrkeudstyr, træpaneler og store glaspartier"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Vis billede",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Træningsmiljø på mobil"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "Billedets link"
    },
    {
      "type": "range",
      "id": "image_blend",
      "label": "Blød overgang ved billedets kant",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "header",
      "content": "Farver"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Baggrund",
      "default": "#202722"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekst",
      "default": "#edf0e8"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Sekundær tekst",
      "default": "#b2bbae"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent og knapper",
      "default": "#d4ed72"
    },
    {
      "type": "header",
      "content": "Afstand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Afstand over på computer",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Afstand under på computer",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Afstand over på mobil",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Afstand under på mobil",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Glas og bevægelse"
    },
    {
      "type": "checkbox",
      "id": "glass_enabled",
      "label": "Glasbaggrund",
      "default": true
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Baggrundsopacitet",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 86
    },
    {
      "type": "range",
      "id": "glass_blur",
      "label": "Sløring",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "checkbox",
      "id": "glass_flow_enabled",
      "label": "Bløde lysbølger ved scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "glass_flow_strength",
      "label": "Lysbølgernes styrke",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typografi"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Overskriftens størrelse",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Overskriftens farve",
      "info": "Tomt felt bruger sektionens tekstfarve."
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Brødtekstens størrelse",
      "min": 85,
      "max": 125,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Brødtekstens farve",
      "info": "Tomt felt bruger sektionens dæmpede farve."
    }
  ],
  "presets": [
    {
      "name": "Purefitness · Partner"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Knap",
      "settings": [
        {
          "type": "checkbox",
          "id": "visible",
          "label": "Vis knappen",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "Knaptekst",
          "default": "Kontakt PureFitness"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Et udfyldt link bruges før kontaktmuligheden."
        },
        {
          "type": "select",
          "id": "action_kind",
          "label": "Kontaktmulighed",
          "options": [
            {
              "value": "projekt",
              "label": "Projekt"
            },
            {
              "value": "katalog",
              "label": "Katalog"
            },
            {
              "value": "service",
              "label": "Service"
            },
            {
              "value": "link",
              "label": "Kun link"
            }
          ],
          "default": "projekt"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Knappens udseende",
          "options": [
            {
              "value": "primary",
              "label": "Fyldt knap"
            },
            {
              "value": "glass",
              "label": "Glasknap"
            },
            {
              "value": "link",
              "label": "Tekstlink"
            }
          ],
          "default": "primary"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Baggrund",
          "info": "Tomt felt bruger accentfarven."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Tekst"
        }
      ]
    },
    {
      "type": "pillar",
      "name": "Søjle",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Overskrift",
          "default": "Udstyr"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Kort tekst"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Stregens farve",
          "info": "Tomt felt bruger accentfarven."
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
