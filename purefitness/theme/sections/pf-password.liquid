{% assign password_form_id = 'StorefrontPassword-' | append: section.id %}
<section class="commerce commerce-password page-width" aria-labelledby="PasswordTitle-{{ section.id }}">
  {% if section.settings.show_brand %}<p class="eyebrow">{% if section.settings.use_shop_name %}{{ shop.name | escape }}{% else %}{{ section.settings.brand_text | escape }}{% endif %}</p>{% endif %}<h1 id="PasswordTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
  {% if section.settings.description != blank %}<p class="commerce-richtext">{{ section.settings.description | escape | newline_to_br }}</p>{% elsif section.settings.show_password_message and shop.password_message != blank %}<div class="commerce-richtext">{{ shop.password_message }}</div>{% endif %}
  {% form 'storefront_password', id: password_form_id, class: 'commerce-password-form' %}
    {% if form.errors %}<div class="commerce-message commerce-message-error" role="alert">{% if section.settings.error_heading != blank %}<p>{{ section.settings.error_heading | escape }}</p>{% endif %}{{ form.errors | default_errors }}</div>{% endif %}
    <label for="StorefrontPasswordInput-{{ section.id }}">{{ section.settings.password_label | escape }}</label><input id="StorefrontPasswordInput-{{ section.id }}" name="password" type="password" placeholder="{{ section.settings.password_placeholder | escape }}" autocomplete="current-password" required><button class="primary-action" type="submit">{{ section.settings.submit_label | escape }}<span aria-hidden="true">↗</span></button>
  {% endform %}
</section>

{% schema %}
{
  "name": "PureFitness adgangskode",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_brand",
      "label": "Vis overlinje",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_shop_name",
      "label": "Brug navnet fra Shopify",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Eget navn / overlinje",
      "default": "PUREFITNESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Et nyt univers er på vej."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Egen introduktion (tom = adgangskodebesked)"
    },
    {
      "type": "checkbox",
      "id": "show_password_message",
      "label": "Vis adgangskodebesked fra Shopify",
      "default": true
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Adgangskodefeltets label",
      "default": "Adgangskode"
    },
    {
      "type": "text",
      "id": "password_placeholder",
      "label": "Adgangskodefeltets eksempeltekst"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Åbn-knappens tekst",
      "default": "Åbn hjemmesiden"
    },
    {
      "type": "text",
      "id": "error_heading",
      "label": "Overskrift over formularfejl"
    }
  ]
}
{% endschema %}
