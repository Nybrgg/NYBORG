      "label": "Baggrund",
      "default": "#202722"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Overskrifter og tekst",
      "default": "#edf0e8"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Brødtekst",
      "default": "#b2bbae"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent og knapper",
      "default": "#d4ed72"
    },
    {
      "type": "range",
      "id": "padding_top",
