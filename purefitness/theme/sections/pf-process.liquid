    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Vis overskriften",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Vis introduktionen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Vis trinnumre",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_steps",
      "label": "Vis trinene",
      "default": true
    },
    {
