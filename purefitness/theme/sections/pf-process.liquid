{% if section.settings.show_section %}
<section id="forloeb-{{ section.id }}" class="pf-section pf-process pf-simple-section pf-container" data-pf-anchor="forloeb" {% if section.settings.show_heading and section.settings.heading != blank %}aria-labelledby="process-title-{{ section.id }}"{% endif %} {% render 'pf-section-glass', s: section.settings %}>
  {% if section.settings.glass_enabled and section.settings.glass_flow_enabled %}<span class="pf-section-glass-wave" aria-hidden="true"></span>{% endif %}
  <div class="pf-section__head" data-pf-reveal>
    {% if section.settings.show_heading and section.settings.heading != blank %}<h2 id="process-title-{{ section.id }}" class="pf-title">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.show_description and section.settings.description != blank %}<p class="pf-lead">{{ section.settings.description | escape | newline_to_br | replace: '<br />', ' ' | replace: '<br>', ' ' }}</p>{% endif %}
  </div>
  {% if section.settings.show_steps %}
    <ol class="pf-process__track" data-pf-reveal>
      {% assign visible_index = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.visible %}
          {% assign visible_index = visible_index | plus: 1 %}
          <li class="pf-process__step" style="--pf-step:{{ visible_index }}" {{ block.shopify_attributes }}>
            <span class="pf-process__node" aria-hidden="true">{% if section.settings.show_numbers and block.settings.show_number %}{% if block.settings.number != blank %}{{ block.settings.number | escape }}{% else %}{{ visible_index }}{% endif %}{% endif %}</span>
            <div class="pf-process__body">
              {% if block.settings.show_title and block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
              {% if block.settings.show_description and block.settings.description != blank %}<p>{{ block.settings.description | escape | newline_to_br }}</p>{% endif %}
              {% if block.settings.show_action and block.settings.action_label != blank %}{% if block.settings.action_url != blank %}<a class="pf-link" href="{{ block.settings.action_url | escape }}"><span>{{ block.settings.action_label | escape }}</span>{% render 'pf-icon', name: 'arrow-up-right', size: 16 %}</a>{% elsif block.settings.action_kind != 'none' %}<button type="button" class="pf-link" data-pf-contact="{{ block.settings.action_kind | escape }}"><span>{{ block.settings.action_label | escape }}</span>{% render 'pf-icon', name: 'arrow-up-right', size: 16 %}</button>{% endif %}{% endif %}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  {% endif %}
</section>
{% endif %}

{% schema %}
{
  "name": "Purefitness · Forløb",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Vis sektionen",
      "default": true
