{% liquid
  assign universe_url = routes.root_url | append: '?view=univers'
  if settings.universe_url_override != blank
    assign universe_url = settings.universe_url_override
  endif
%}
{% if section.settings.show_section %}
<section id="loesninger-{{ section.id }}" class="pf-section pf-solutions pf-simple-section pf-container" data-pf-anchor="loesninger" {% if section.settings.show_heading and section.settings.heading != blank %}aria-labelledby="solutions-title-{{ section.id }}"{% endif %} {% render 'pf-section-glass', s: section.settings %}>
  {% if section.settings.glass_enabled and section.settings.glass_flow_enabled %}<span class="pf-section-glass-wave" aria-hidden="true"></span>{% endif %}
  <div class="pf-section__head" data-pf-reveal>
    {% if section.settings.show_heading and section.settings.heading != blank %}<h2 id="solutions-title-{{ section.id }}" class="pf-title">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.show_description and section.settings.description != blank %}<p class="pf-lead">{{ section.settings.description | escape | newline_to_br }}</p>{% endif %}
  </div>
  {% if section.settings.show_rows %}
    <div class="pf-solutions__layout" data-pf-tabs data-pf-solutions data-pf-reveal>
      <div class="pf-solutions__tabs" role="tablist" aria-orientation="vertical" aria-label="{{ section.settings.heading | escape }}">
        {% assign visible_index = 0 %}
        {% for block in section.blocks %}
          {% if block.settings.visible and block.settings.label != blank %}
            {% assign visible_index = visible_index | plus: 1 %}
            <button type="button" class="pf-solutions__tab" role="tab" id="solution-tab-{{ block.id }}" aria-controls="solution-panel-{{ block.id }}" aria-selected="{% if visible_index == 1 %}true{% else %}false{% endif %}" tabindex="{% if visible_index == 1 %}0{% else %}-1{% endif %}" data-pf-tab {{ block.shopify_attributes }}>
              {% if section.settings.show_numbers and block.settings.show_number %}<span class="pf-solutions__index" aria-hidden="true">{% if block.settings.number != blank %}{{ block.settings.number | escape }}{% else %}{% if visible_index < 10 %}0{% endif %}{{ visible_index }}{% endif %}</span>{% endif %}
              <span class="pf-solutions__label">{{ block.settings.label | escape }}</span>
              <span class="pf-solutions__chevron" aria-hidden="true">{% render 'pf-icon', name: 'arrow-right', size: 18 %}</span>
            </button>
          {% endif %}
        {% endfor %}
      </div>
      <div class="pf-solutions__panels">
        {% assign visible_index = 0 %}
        {% for block in section.blocks %}
          {% if block.settings.visible and block.settings.label != blank %}
            {% assign visible_index = visible_index | plus: 1 %}
            {% assign scene = block.settings.scene_id | handleize %}
            {% assign row_universe_url = block.settings.universe_url %}
            {% if row_universe_url == blank %}{% capture row_universe_url %}{{ universe_url }}#{{ scene }}{% endcapture %}{% endif %}
            {% assign scene_asset = 'pf-env-' | append: scene | append: '.webp' %}
            <div class="pf-solutions__panel" role="tabpanel" id="solution-panel-{{ block.id }}" aria-labelledby="solution-tab-{{ block.id }}" data-pf-panel {% unless visible_index == 1 %}hidden{% endunless %} {{ block.shopify_attributes }}>
              <figure class="pf-solutions__media">
                {% render 'pf-image', image: block.settings.image, asset: scene_asset, alt: block.settings.image_alt, loading: 'lazy', sizes: '(max-width:760px) 100vw, 62vw', width: 1600, height: 1000 %}
              </figure>
              <div class="pf-solutions__card pf-glass">
                <h3 class="pf-solutions__title">{{ block.settings.label | escape }}</h3>
                {% if block.settings.show_summary and block.settings.summary != blank %}<p class="pf-solutions__summary">{{ block.settings.summary | escape | newline_to_br }}</p>{% endif %}
                {% if block.settings.show_description and block.settings.description != blank %}<p class="pf-solutions__detail">{{ block.settings.description | escape | newline_to_br }}</p>{% endif %}
                {% capture contact_action %}{% if block.settings.show_contact and block.settings.contact_label != blank %}{% if block.settings.contact_url != blank %}<a class="pf-button pf-button--primary" href="{{ block.settings.contact_url | escape }}"><span>{{ block.settings.contact_label | escape }}</span><span class="pf-button__icon">{% render 'pf-icon', name: 'arrow-up-right', size: 17 %}</span></a>{% else %}<button type="button" class="pf-button pf-button--primary" data-pf-contact="{{ block.settings.contact_kind | escape }}"><span>{{ block.settings.contact_label | escape }}</span><span class="pf-button__icon">{% render 'pf-icon', name: 'arrow-up-right', size: 17 %}</span></button>{% endif %}{% endif %}{% endcapture %}
                {% capture universe_action %}{% if block.settings.show_universe and block.settings.universe_label != blank %}<a class="pf-link" href="{{ row_universe_url | escape }}"><span>{{ block.settings.universe_label | escape }}</span>{% render 'pf-icon', name: 'arrow-right', size: 17 %}</a>{% endif %}{% endcapture %}
                {% if contact_action != blank or universe_action != blank %}<div class="pf-actions pf-actions--compact">{% if block.settings.action_order == 'universe_first' %}{{ universe_action }}{{ contact_action }}{% else %}{{ contact_action }}{{ universe_action }}{% endif %}</div>{% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>
{% endif %}

{% schema %}
{
  "name": "Purefitness · Løsninger",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Vis sektionen",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Hvilket rum skal vi skabe?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Introduktion",
      "default": "Forskellige brugere stiller forskellige krav. Find det miljø, der passer til jer."
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Vis overskriften",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Vis introduktionen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Vis rækkenumre",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rows",
      "label": "Vis løsninger",
      "default": true
    },
    {
      "type": "header",
      "content": "Farver og afstande"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Baggrund",
      "default": "#202722"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Overskrifter og tekst",
      "default": "#edf0e8"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Brødtekst",
      "default": "#b2bbae"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent og knapper",
      "default": "#d4ed72"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Afstand over indhold",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Afstand under indhold",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Afstand over indhold på mobil",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Afstand under indhold på mobil",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Bløde baggrundsovergange"
    },
    {
      "type": "range",
      "id": "fade_top",
      "label": "Overgang øverst, computer",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80,
      "info": "0 giver en skarp kant. Overgangen begrænses til 45 % af sektionens højde."
    },
    {
      "type": "range",
      "id": "fade_bottom",
      "label": "Overgang nederst, computer",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80,
      "info": "0 giver en skarp kant. Overgangen begrænses til 45 % af sektionens højde."
    },
    {
      "type": "range",
      "id": "fade_top_mobile",
      "label": "Overgang øverst, mobil",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56,
      "info": "0 giver en skarp kant. Overgangen begrænses til 45 % af sektionens højde."
    },
    {
      "type": "range",
      "id": "fade_bottom_mobile",
      "label": "Overgang nederst, mobil",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56,
      "info": "0 giver en skarp kant. Overgangen begrænses til 45 % af sektionens højde."
    },
    {
      "type": "header",
      "content": "Glas og bevægelse"
    },
    {
      "type": "checkbox",
      "id": "glass_enabled",
      "label": "Glasbaggrund",
      "default": true
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Baggrundsopacitet",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 86
    },
    {
      "type": "range",
      "id": "glass_blur",
      "label": "Sløring",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "checkbox",
      "id": "glass_flow_enabled",
      "label": "Bløde lysbølger ved scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "glass_flow_strength",
      "label": "Lysbølgernes styrke",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purefitness · Løsninger",
      "blocks": [
        {
          "type": "environment",
          "settings": {
            "scene_id": "fitness",
            "label": "Fitnesscentre",
            "summary": "Plads til forskellige træningsformer, et naturligt flow og udstyr, der passer til medlemmernes behov. Se mulighederne for både nye centre og eksisterende faciliteter.",
            "description": "Styrke, kondition og frie vægte. Vi hjælper med valg af udstyr, indretning og installation."
          }
        },
        {
          "type": "environment",
          "settings": {
            "scene_id": "hoteller",
            "label": "Hoteller",
            "summary": "Et træningsrum som en naturlig del af opholdet. Indretningen skal være indbydende, let at bruge og tilpasset den plads, hotellet har til rådighed.",
            "description": "Materialer, plads og udstyr tænkes sammen med hotellets udtryk. En løsning, der passer til gæsternes behov."
          }
        },
        {
          "type": "environment",
          "settings": {
            "scene_id": "erhverv",
            "label": "Erhverv",
            "summary": "Træning tættere på arbejdsdagen. Et funktionelt rum kan give medarbejderne mulighed for bevægelse før, under eller efter arbejdet.",
            "description": "Fra en mindre træningszone til et helt motionsrum. Vi tilpasser indretningen til jeres arbejdsplads."
          }
        },
        {
          "type": "environment",
          "settings": {
            "scene_id": "foreninger",
            "label": "Foreninger",
            "summary": "Fælles faciliteter til forskellige brugere og aktiviteter. Find en indretning og et udvalg af udstyr, der passer til foreningens hverdag.",
            "description": "Fleksible arealer, der fungerer til fællestræning og individuelle programmer. Vi hjælper jer med at udnytte pladsen."
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "environment",
      "name": "Træningsmiljø",
      "settings": [
        {
          "type": "checkbox",
          "id": "visible",
          "label": "Vis dette træningsmiljø",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "Titel",
          "default": "Fitnesscentre"
        },
        {
          "type": "textarea",
          "id": "summary",
          "label": "Altid synlig beskrivelse",
          "default": "Plads til forskellige træningsformer, et naturligt flow og udstyr, der passer til medlemmernes behov. Se mulighederne for både nye centre og eksisterende faciliteter."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Flere oplysninger",
          "default": "Styrke, kondition og frie vægte. Vi hjælper med valg af udstyr, indretning og installation."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Billede",
          "info": "Tomt felt bruger en visualisering fra 3D-universet."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Billedbeskrivelse"
        },
        {
          "type": "select",
          "id": "scene_id",
          "label": "Tilsvarende 3D-miljø",
          "options": [
            {
              "value": "fitness",
              "label": "Fitnesscentre"
            },
            {
              "value": "hoteller",
              "label": "Hoteller"
            },
            {
              "value": "erhverv",
              "label": "Erhverv"
            },
            {
              "value": "foreninger",
              "label": "Foreninger"
            }
          ],
          "default": "fitness"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Eget rækkenummer (valgfrit)"
        },
        {
          "type": "checkbox",
          "id": "show_summary",
          "label": "Vis den korte beskrivelse",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_description",
          "label": "Vis flere oplysninger",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_contact",
          "label": "Vis kontaktknappen",
          "default": true
        },
        {
          "type": "text",
          "id": "contact_label",
          "label": "Kontaktknappens tekst",
          "default": "Tal om jeres løsning"
        },
        {
          "type": "url",
          "id": "contact_url",
          "label": "Kontaktknappens egen destination"
        },
        {
          "type": "select",
          "id": "contact_kind",
          "label": "Kontaktformular uden egen destination",
          "options": [
            {
              "value": "projekt",
              "label": "Projekt"
            },
            {
              "value": "katalog",
              "label": "Katalog"
            },
            {
              "value": "service",
              "label": "Service"
            }
          ],
          "default": "projekt"
        },
        {
          "type": "checkbox",
          "id": "show_universe",
          "label": "Vis universknappen",
          "default": true
        },
        {
          "type": "text",
          "id": "universe_label",
          "label": "Universknappens tekst",
          "default": "Oplev miljøet"
        },
        {
          "type": "url",
          "id": "universe_url",
          "label": "Universknappens egen destination"
        },
        {
          "type": "select",
          "id": "action_order",
          "label": "Knappernes rækkefølge",
          "options": [
            {
              "value": "contact_first",
              "label": "Kontakt først"
            },
            {
              "value": "universe_first",
              "label": "Univers først"
            }
          ],
          "default": "contact_first"
        },
        {
          "type": "checkbox",
          "id": "show_number",
          "label": "Vis dette rækkenummer",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
