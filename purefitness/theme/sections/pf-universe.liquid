{%- liquid
  assign pf_home_url = routes.root_url
  assign pf_contact_url = routes.root_url | append: '?view=contact'
  assign pf_embedded = false
  if template.name == 'index' and template.suffix == blank
    assign pf_embedded = true
  endif
-%}
{% unless pf_embedded %}{{ 'pf-universe-dom.css' | asset_url | stylesheet_tag }}{% endunless %}
{% style %}
  body.pf-universe-page {
    {% if section.settings.hud_glass_enabled %}
      --pf-universe-hud-glass-surface: linear-gradient(135deg, #ffffff0e, #ffffff02), rgb(23 25 22 / {{ section.settings.hud_glass_opacity | divided_by: 100.0 }});
      --pf-universe-hud-glass-blur: {{ section.settings.hud_glass_blur }}px;
      --pf-universe-hud-glass-filter: blur(var(--pf-universe-hud-glass-blur)) saturate(115%);
      --pf-universe-hud-glass-border: #ffffff2e;
      --pf-universe-hud-glass-shadow: 0 10px 32px #00000020, inset 0 1px 0 #ffffff0c;
      --pf-universe-hud-glass-radius: 0px;
    {% else %}
      --pf-universe-hud-glass-surface: initial;
      --pf-universe-hud-glass-blur: 0px;
      --pf-universe-hud-glass-filter: none;
      --pf-universe-hud-glass-border: #ffffff24;
      --pf-universe-hud-glass-shadow: none;
      --pf-universe-hud-glass-radius: 0px;
    {% endif %}
    --pf-universe-hud-flow-amplitude: {{ section.settings.hud_flow_amplitude }}px;
    {% if section.settings.hud_glass_enabled and section.settings.hud_flow_enabled %}
      --pf-universe-hud-flow-enabled: 1;
      --pf-universe-hud-flow-content: '';
    {% else %}
      --pf-universe-hud-flow-enabled: 0;
      --pf-universe-hud-flow-content: none;
    {% endif %}
    {% if section.settings.menu_glass_enabled %}
      --pf-universe-menu-glass-surface: linear-gradient(155deg, #ffffff04, #ffffff00 55%), rgb(24 29 24 / {{ section.settings.menu_glass_opacity | divided_by: 100.0 }});
      --pf-universe-menu-glass-blur: {{ section.settings.menu_glass_blur }}px;
      --pf-universe-menu-glass-filter: blur(var(--pf-universe-menu-glass-blur)) saturate(115%);
      --pf-universe-menu-glass-border: #ffffff30;
      --pf-universe-menu-glass-backdrop: #060a0766;
    {% else %}
      --pf-universe-menu-glass-surface: initial;
      --pf-universe-menu-glass-blur: 0px;
      --pf-universe-menu-glass-filter: none;
      --pf-universe-menu-glass-border: #f2f0e82b;
      --pf-universe-menu-glass-backdrop: #0008;
    {% endif %}
    --pf-universe-menu-flow-amplitude: {{ section.settings.menu_flow_amplitude }}px;
    {% if section.settings.menu_glass_enabled and section.settings.menu_flow_enabled %}
      --pf-universe-menu-flow-enabled: 1;
      --pf-universe-menu-flow-content: '';
    {% else %}
      --pf-universe-menu-flow-enabled: 0;
      --pf-universe-menu-flow-content: none;
    {% endif %}
    {% if section.settings.drawer_glass_enabled %}
      --pf-universe-drawer-glass-surface: linear-gradient(155deg, #ffffff04, #ffffff00 60%), rgb(25 30 26 / {{ section.settings.drawer_glass_opacity | divided_by: 100.0 }});
      --pf-universe-drawer-glass-blur: {{ section.settings.drawer_glass_blur }}px;
      --pf-universe-drawer-glass-filter: blur(var(--pf-universe-drawer-glass-blur)) saturate(115%);
      --pf-universe-drawer-glass-border: #ffffff2b;
      --pf-universe-drawer-glass-backdrop: #060a076b;
    {% else %}
      --pf-universe-drawer-glass-surface: initial;
      --pf-universe-drawer-glass-blur: 0px;
      --pf-universe-drawer-glass-filter: none;
      --pf-universe-drawer-glass-border: #f2f0e82b;
      --pf-universe-drawer-glass-backdrop: #0008;
    {% endif %}
    --pf-universe-drawer-flow-amplitude: {{ section.settings.drawer_flow_amplitude }}px;
    {% if section.settings.drawer_glass_enabled and section.settings.drawer_flow_enabled %}
      --pf-universe-drawer-flow-enabled: 1;
      --pf-universe-drawer-flow-content: '';
    {% else %}
      --pf-universe-drawer-flow-enabled: 0;
      --pf-universe-drawer-flow-content: none;
    {% endif %}
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    @media (prefers-reduced-transparency: no-preference) and (forced-colors: none) {
      body.pf-universe-page {
        {% if section.settings.hud_glass_enabled %}
          --pf-universe-hud-glass-edge-border: #ffffff38;
          --pf-universe-hud-glass-edge-shadow: 0 10px 32px #00000020, inset 0 1px 0 #ffffff14;
          --pf-universe-hud-metadata-color: #ead4b3;
        {% endif %}
        {% if section.settings.menu_glass_enabled %}
          --pf-universe-menu-glass-edge-border: #ffffff3a;
          --pf-universe-menu-glass-edge-shadow: -20px 0 80px #00000036, inset 1px 0 0 #ffffff12;
        {% endif %}
        {% if section.settings.drawer_glass_enabled %}
          --pf-universe-drawer-glass-edge-border: #ffffff35;
          --pf-universe-drawer-glass-edge-shadow: -20px 0 80px #00000036, inset 1px 0 0 #ffffff12;
        {% endif %}
      }
    }
  }
{% endstyle %}

