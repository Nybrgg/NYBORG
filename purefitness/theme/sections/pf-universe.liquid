  <template data-icon="pause">{% render 'pf-icon', name: 'pause', size: 18 %}</template>
  <template data-icon="play">{% render 'pf-icon', name: 'play', size: 18 %}</template>
  <template data-icon="chevron-down">{% render 'pf-icon', name: 'chevron-down', size: 18 %}</template>
  <template data-icon="info">{% render 'pf-icon', name: 'info', size: 18 %}</template>
  <template data-icon="sun">{% render 'pf-icon', name: 'sun', size: 18 %}</template>
  <template data-icon="sunset">{% render 'pf-icon', name: 'sunset', size: 18 %}</template>
  {% if request.design_mode %}<div data-pf-universe-editor-blocks>{% for block in section.blocks %}<span hidden data-pf-editor-block data-block-id="{{ block.id | escape }}" {{ block.shopify_attributes }}></span>{% endfor %}</div>{% endif %}
  <div data-pf-universe-host></div>
  <noscript>
    <div class="no-script">
      {% liquid
        assign fallback_title = 'pf_universe.no_script_title' | t
        assign fallback_intro = 'pf_universe.no_script_intro' | t
        assign fallback_service = 'pf_universe.no_script_service' | t
        assign fallback_contact = 'pf_universe.contact_purefitness' | t
        assign fallback_contact_url = pf_contact_url
        assign show_fallback_contact = true
        for block in section.blocks
          if block.type == 'ui_accessibility'
            assign fallback_title = block.settings.no_script_title
            assign fallback_intro = block.settings.no_script_intro
            assign fallback_service = block.settings.no_script_service
            assign fallback_contact = block.settings.no_script_contact_label
            assign fallback_contact_url = block.settings.no_script_contact_url | default: pf_contact_url
            assign show_fallback_contact = block.settings.show_no_script_contact
          endif
        endfor
      %}
      <h1>{{ fallback_title | escape }}</h1>
      <p>{{ fallback_intro | escape }}</p>
      <p>{{ fallback_service | escape }}</p>
      {% if show_fallback_contact and fallback_contact != blank %}<a href="{{ fallback_contact_url | escape }}">{{ fallback_contact | escape }}</a>{% endif %}
    </div>
  </noscript>
</section>
{% unless pf_embedded %}<script type="module" src="{{ 'pf-universe.js' | asset_url }}"></script>{% endunless %}
